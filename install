say() { printf '  - %s\n' "$*"; }

# banner: the title above the summary. On a terminal at least 32 columns wide
# it is the logo (four rising bars, amber when colour is allowed) with the name
# beside it; drawn with block characters when the locale is UTF-8 and with
# plain ones otherwise. Anywhere else (piped, saved to a file, TERM=dumb or a
# narrow terminal) it is the one plain line it has always been.
banner() {
  local cols="" amber="" bold="" off="" l1 l2 l3
  if [ -t 1 ] && [ -n "${TERM:-}" ] && [ "$TERM" != dumb ]; then
    # Not /dev/tty: with no controlling terminal opening it fails, and the
    # shell says so.
    { cols="$(stty size <&3 2>/dev/null | awk '{print $2}')"; } 3>&1
    [[ $cols =~ ^[0-9]+$ ]] || cols=80
  fi
  if [ -z "$cols" ] || [ "$cols" -lt 32 ]; then
    printf '\nfreePanel installer\n'
    return
  fi
  if [ -z "${NO_COLOR:-}" ]; then
    case "$TERM" in
      *256color* | *truecolor* | *direct*) amber=$'\033[38;5;214m' ;;
      *) amber=$'\033[33m' ;;
    esac
    bold=$'\033[1m'
    off=$'\033[0m'
  fi
  case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
    *[Uu][Tt][Ff]-8* | *[Uu][Tt][Ff]8*)
      l1='      ▄▄ ██'
      l2='   ▄▄ ██ ██'
      l3='██ ██ ██ ██'
      ;;
    *)
      l1='      .. ##'
      l2='   .. ## ##'
      l3='## ## ## ##'
      ;;
  esac
  printf '\n  %s%s%s\n  %s%s%s   %sfreePanel%s\n  %s%s%s   installer\n\n' \
    "$amber" "$l1" "$off" "$amber" "$l2" "$off" "$bold" "$off" "$amber" "$l3" "$off"
}
die() {
  printf 'freePanel installer: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'USAGE'
freePanel installer

  curl -fsSL https://repo.atlantishosting.net/install | sudo bash

Installs freePanel and its services and prints the address where you create
your admin login. Enter the licence key on the panel's Licence page, or give it
up front without putting it on a command line (any command line, sudo's too,
can be read by every user of the server while it runs):

  export FREEPANEL_LICENSE_KEY=YOUR-KEY
  curl -fsSL https://repo.atlantishosting.net/install | sudo -E bash

Choices (optional; they go after "bash -s --"):

  --hostname NAME    the server's name; the default is its own, which must be a
                     full name such as server.example.com
  --no-firewall      leave the firewall alone and turn OFF login protection
                     (the default turns the firewall and login protection on
                     and opens SSH's, the panel's and the services' ports)
  --php 8.3          the PHP version new sites start with
  --web --mysql --postgres --dns --mail --spam --dbadmin --webmail --dav --ftp --protect
                     choose the components yourself: the installer is then
                     given your flags (and --hostname), and --protect unless
                     --no-firewall is given

Every flag of installer/install.sh works here; it is passed on as it is.
FREEPANEL_RELEASE=1.2.3 installs that release instead of the newest.
USAGE
}

# The private working folder; the exit trap in main removes it.
TMP=
# What installer/install.sh printed this run (the log keeps all runs).
OUT=
# The licence key, if one was given: only installer/install.sh gets it.
LICKEY=
# The width of the terminal, for the one line a run keeps rewriting.
COLS=80
# What the installer is given, the name the server goes by, and what is said
# about the choice of components.
ARGV=()
HOST=
WHAT=

# fetch URL DEST MAXBYTES: one file, https only (also for redirects), with a
# size cap so that a wrong answer cannot fill the disk.
fetch() {
  curl -fsSL --proto "$CURL_PROTO" --proto-redir "$CURL_PROTO" --tlsv1.2 --max-redirs 3 \
    --retry 3 --retry-delay 2 --connect-timeout 20 --max-time 1800 --max-filesize "$3" \
    -o "$2" -- "$1" || die "could not download $1"
}

need_gpg() {
  command -v gpg >/dev/null 2>&1 && return 0
  say "Installing gpg, to check the download (from this system's own repositories)"
  if command -v dnf >/dev/null 2>&1; then
    dnf -y -q install gnupg2 >/dev/null || true
  elif command -v apt-get >/dev/null 2>&1; then
    # A fresh Debian cloud image has no package lists yet: fetch them, once,
    # only if the install cannot find gnupg without them.
    DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=600 install -y -q gnupg >/dev/null 2>&1 ||
      { DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=600 update -q >/dev/null &&
        DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=600 install -y -q gnupg >/dev/null; } || true
  fi
  command -v gpg >/dev/null 2>&1 || die "gpg is not installed and could not be installed; install gnupg and run this again"
}

# require_pin: stops a copy of this script that has no key pinned.
require_pin() {
  [ -n "$PINNED_FPR" ] || die "this installer has no signing key pinned yet, so it cannot check anything and will not run (freePanel has not been released)"
  [[ $PINNED_FPR =~ ^[0-9A-F]{40}$ ]] || die "the pinned fingerprint is not 40 hexadecimal digits"
}

# make_keyring DIR: a gpg home with the pinned key in it and no other.
make_keyring() {
  local home=$1 prim
  mkdir -m 700 -- "$home"
  pinned_key | "${GPG[@]}" --homedir "$home" --quiet --import >/dev/null 2>&1 ||
    die "the pinned public key could not be read"
  # Exactly one primary key, and it is the pinned one. (A pinned block that
  # held a second key would otherwise add a second signer.)
  prim="$("${GPG[@]}" --homedir "$home" --with-colons --fingerprint --list-keys 2>/dev/null |
    awk -F: '$1=="pub"{n++; want=1; next} $1=="sub"{want=0; next} $1=="fpr" && want {print $10; want=0}' || true)"
  [ "$prim" = "$PINNED_FPR" ] || die "the pinned public key is not exactly the key with the pinned fingerprint"
}

# verify_signature HOME SIG FILE: succeeds only for a good signature, made
# by the pinned key or a subkey of it, that is not expired or revoked.
verify_signature() {
  local home=$1 sig=$2 file=$3 status rc=0 n
  status="$("${GPG[@]}" --homedir "$home" --status-fd 1 --verify "$sig" "$file" 2>/dev/null)" || rc=$?
  [ "$rc" -eq 0 ] || return 1
  if grep -Eq '^\[GNUPG:\] (BADSIG|EXPSIG|EXPKEYSIG|REVKEYSIG|ERRSIG|NO_PUBKEY|NODATA|BADARMOR|INV_SGNR|KEYREVOKED)( |$)' <<<"$status"; then
    return 1
  fi
  grep -Eq '^\[GNUPG:\] GOODSIG ' <<<"$status" || return 1
  # One VALIDSIG line; its last field is the fingerprint of the primary key
  # of whoever signed (the key itself, or the primary of the subkey).
  n="$(grep -Ec '^\[GNUPG:\] VALIDSIG ' <<<"$status" || true)"
  [ "$n" = 1 ] || return 1
  [ "$(awk '$2=="VALIDSIG"{print $NF}' <<<"$status")" = "$PINNED_FPR" ]
}

# check_names LIST TOP: every entry of the tarball is TOP or lies under TOP/,
# with no ".." in it.
check_names() {
  local list=$1 top=$2 name
  [ -s "$list" ] || return 1
  while IFS= read -r name; do
    case "$name" in
      "$top" | "$top"/) ;;
      "$top"/*) ;;
      *) return 1 ;;
    esac
    case "/$name/" in
      */../*) return 1 ;;
    esac
  done <"$list"
}

# os_field NAME: a field of os-release (ID, VERSION_ID, PRETTY_NAME), or nothing.
os_field() {
  # shellcheck disable=SC1090 # the system's own file, read in a subshell
  (. "$OS_RELEASE" 2>/dev/null && printf '%s' "${!1:-}") || true
}

# is_fqdn NAME: a full name such as server.example.com, not an address and
# not one of the names a machine gives itself.
is_fqdn() {
  local h=${1,,}
  [ "${#h}" -le 253 ] || return 1
  [[ $h =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]([a-z0-9-]{0,61}[a-z0-9])?$ ]] || return 1
  case "$h" in
    localhost | *.localhost | *.localdomain | *.local | *.internal | *.lan | *.invalid | *.home.arpa) return 1 ;;
  esac
}

# plan ARGS...: sets ARGV (what the installer is given), HOST (the name the
# panel will use) and WHAT (the components, in words, for the first lines).
plan() {
  local a prev="" own=0 has_host=0 has_fw=0 wants="" skipped=""
  for a in "$@"; do
    case "$a" in
      --web | --mysql | --postgres | --dns | --mail | --spam | --dbadmin | --webmail | --dav | --ftp | --protect) own=1 ;;
      --hostname) has_host=1 ;;
      --open-firewall | --no-firewall) has_fw=1 ;;
    esac
    if [ "$prev" = --hostname ]; then HOST=$a; fi
    prev=$a
  done
  ARGV=("$@")

  case "$(os_field ID):$(os_field VERSION_ID)" in
    almalinux:9* | rocky:9* | rhel:9* | cloudlinux:9*) : ;;
    almalinux:10* | rocky:10* | rhel:10* | cloudlinux:10*) : ;;
    ubuntu:24.04 | ubuntu:26.04 | debian:12*) : ;;
    *) die "freePanel installs on AlmaLinux, Rocky Linux, RHEL or CloudLinux 9 or 10, on Ubuntu 24.04 or 26.04 and on Debian 12; this server runs $(os_field PRETTY_NAME)" ;;
  esac

  if [ "$has_host" = 0 ]; then
    HOST="$(hostname -f 2>/dev/null || hostname 2>/dev/null || true)"
    HOST=${HOST%.}
    is_fqdn "$HOST" || die "this server's name is \"${HOST:-unknown}\", which is not a full name. Give the server one under a domain you own with: hostnamectl set-hostname server.example.com   and run this again (or add: bash -s -- --hostname server.example.com   to name it for freePanel only)"
    ARGV=(--hostname "$HOST" "${ARGV[@]}")
  fi

  if [ "$own" = 1 ]; then
    WHAT="what you asked for"
    # Login protection comes with any choice of components, unless
    # --no-firewall leaves the firewall alone; the first lines say so.
    if has_arg --no-firewall "$@"; then
      WHAT="$WHAT; LOGIN PROTECTION IS OFF because of --no-firewall"
    elif ! has_arg --protect "$@"; then
      ARGV+=(--protect)
      WHAT="$WHAT, with the firewall and login protection"
    fi
    return 0
  fi
  ARGV+=("${FULL_FLAGS[@]}")
  wants="websites, databases and their admin tool (port 7445), DNS, mail, webmail with calendars and contacts, and FTP"
  # Login protection is always added, unless --no-firewall says to leave the
  # firewall alone, and then the first lines say it is off. On EL the
  # installer turns firewalld on when it is off, with SSH, the panels' and
  # the services' ports opened before it starts; on Ubuntu and Debian the
  # bans are nftables tables of their own and need no firewall running.
  if has_arg --no-firewall "$@"; then
    skipped="; LOGIN PROTECTION IS OFF because of --no-firewall"
  else
    ARGV+=(--protect)
    wants="$wants, the firewall and login protection"
  fi
  WHAT="the panel with $wants$skipped"
  [ "$has_fw" = 1 ] || ARGV+=(--open-firewall)
}

# has_arg FLAG ARGS...
has_arg() {
  local f=$1 a
  shift
  for a in "$@"; do [ "$a" != "$f" ] || return 0; done
  return 1
}

# make_workdir: a new private folder where programs may run, which the
# installer needs (a /var/tmp mounted noexec would make its check for its own
# binaries fail with a message about building a release). It tries each of
# WORK_BASES in turn and keeps the first that lets a file in it be run.
make_workdir() {
  local base d
  for base in "${WORK_BASES[@]}"; do
    d="$(mktemp -d "$base/freepanel-install.XXXXXX" 2>/dev/null)" || continue
    if printf '#!/bin/sh\nexit 0\n' >"$d/probe" 2>/dev/null && chmod 700 "$d/probe" && "$d/probe" 2>/dev/null; then
      rm -f "$d/probe"
      printf '%s\n' "$d"
      return 0
    fi
    rm -rf -- "$d"
  done
  return 1
}

# record_line LINE TTY: keeps a line the installer printed in $OUT (this run)
# and in the log (all runs); a line that announces a step ("==> ...") is also
# shown, rewritten in place on a terminal (when it fits in COLS columns) and
# one under the other elsewhere.
record_line() {
  local line=$1 tty=$2 text
  # A full disk costs the log its lines, not the install its output: a failed
  # write here must not end this reader, which would cut the installer off.
  printf '%s\n' "$line" 2>/dev/null >>"$OUT" || true
  printf '%s\n' "$line" 2>/dev/null >>"$LOG_FILE" || true
  case "$line" in
    *'==> '*)
      text=${line#*==> }
      text=${text%$'\033[0m'}
      if [ "$tty" = 1 ] && [ $((${#text} + 8)) -le "$COLS" ]; then
        printf '\r\033[K      > %s' "$text"
      elif [ "$tty" = 1 ]; then
        # Too long for one line of this terminal: kept whole, on its own lines,
        # not cut short (the ports a step opens are at its end).
        printf '\r\033[K      > %s\n' "$text"
      else
        printf '      > %s\n' "$text"
      fi
      ;;
  esac
}

# read_steps RCFILE: reads the installer's output from standard input until it
# ends. The output ends when every program that had it open has closed it; a
# program the installer left running with it open would keep this waiting
# for ever, so once RCFILE exists (the installer has finished) the wait ends
# after two quiet seconds, or about five seconds at most if that program
# keeps writing; what is left of the output is then read and thrown away in the
# background so that whatever holds it open does not get a broken pipe.
read_steps() {
  local rcfile=$1 line st acc="" tty=0 finished=""
  [ -t 1 ] && tty=1
  if [ "$tty" = 1 ]; then
    # Standard output is the terminal (stdin is the pipe); fd 3 is a copy of it
    # that the command substitution below can use, as its own stdout is a pipe.
    # Not /dev/tty: with no controlling terminal opening it fails, and the
    # shell says so.
    { COLS="$(stty size <&3 2>/dev/null | awk '{print $2}')"; } 3>&1
    [[ $COLS =~ ^[0-9]+$ ]] && [ "$COLS" -ge 40 ] || COLS=80
  fi
  while :; do
    st=0
    IFS= read -r -t 2 line || st=$?
    acc+=$line
    if [ -z "$finished" ] && [ -e "$rcfile" ]; then finished=$SECONDS; fi
    if [ "$st" -eq 0 ]; then
      record_line "$acc" "$tty"
      acc=""
      if [ -n "$finished" ] && [ $((SECONDS - finished)) -ge 3 ]; then
        cat <&0 >/dev/null 2>&1 &
        break
      fi
    elif [ "$st" -gt 128 ]; then
      if [ -n "$finished" ]; then
        cat <&0 >/dev/null 2>&1 &
        break
      fi
    else
      break
    fi
  done
  if [ -n "$acc" ]; then record_line "$acc" "$tty"; fi
  if [ "$tty" = 1 ]; then printf '\r\033[K'; fi
}

# run_installer INSTALLER RCFILE ARGS...: runs the installer with no standard
# input and the licence key in its environment alone, keeps all it says in the
# log and in $OUT, and shows one line for each of its steps. It returns the
# installer's exit status; RCFILE is only the sign, for read_steps, that the
# installer has finished, so a disk too full to write it costs nothing.
run_installer() {
  local inst=$1 rcfile=$2 st
  shift 2
  set +e
  {
    rc=0
    if [ -n "$LICKEY" ]; then
      FREEPANEL_LICENSE_KEY="$LICKEY" bash "$inst" "$@" </dev/null 2>&1 || rc=$?
    else
      bash "$inst" "$@" </dev/null 2>&1 || rc=$?
    fi
    echo "$rc" 2>/dev/null >"$rcfile" || true
    exit "$rc"
  } | read_steps "$rcfile"
  st=${PIPESTATUS[0]}
  set -e
  return "$st"
}

# last_match PATTERN: the last match in what the installer printed this run.
last_match() {
  grep -Eo "$1" "$OUT" 2>/dev/null | tail -n 1 || true
}

# summary: what to do next, from the lines the installer prints at its end
# (installer/install.sh, "First-run setup"; a test keeps the two in step).
summary() {
  local setup admin customers notes
  setup="$(last_match 'https://[^ ]+/setup#[A-Za-z0-9_-]+')"
  customers="$(last_match '(^|  )Customers sign in at https://[^ ]+$')"
  customers=${customers##* }
  if [ -n "$setup" ]; then
    admin=${setup%/setup#*}
  else
    admin="$(last_match 'freePanel is running at https://[^ [:cntrl:]]+')"
    admin=${admin##* }
  fi
  echo
  if [ -n "$setup" ]; then
    echo "freePanel is installed."
    echo
    echo "  Create your admin login here (the link works once, for 24 hours):"
    echo "    $setup"
  else
    echo "freePanel is installed (or updated)."
    echo
    echo "  Your admin login already exists."
  fi
  if grep -q '^  Licence: ' "$OUT" 2>/dev/null; then
    echo
    echo "  Then enter your licence key on the Licence page."
    if grep -q '^  The server must reach the licence service' "$OUT" 2>/dev/null; then
      echo "  The server must reach the licence service over HTTPS (outbound port 443). Sites and mail are not affected."
    fi
  fi
  echo
  if [ -n "$admin" ]; then echo "  Admin panel:     $admin"; fi
  if [ -n "$customers" ]; then echo "  Customer panel:  $customers"; fi
  if [ -z "$admin" ] && [ -z "$setup" ]; then
    echo "  The addresses to sign in at are at the end of the log."
  fi
  echo "  Install log:     $LOG_FILE"
  # Anything the installer called a warning (such as a licence key it could
  # not store) is shown, not left in the log.
  if grep -Eq '^(install: warning: |  Warning: )' "$OUT" 2>/dev/null; then
    echo
    grep -E '^(install: warning: |  Warning: )' "$OUT" | head -n 5 | sed 's/^  *//; s/^/  /'
  fi
  # The notes the installer ends with (the mail sender, login protection and
  # who it never blocks, ports it did not open, disk quotas): all of them, in
  # its words, apart from the licence block, whose commands this script has
  # said in its own words above.
  notes="$(awk '
    /^  Customers sign in at /{seen=1; next}
    !seen{next}
    /^  Licence: /{lic=1; next}
    lic && (/^    / || /^  The server must reach the licence service/ || /^  to see until when/){next}
    {lic=0; print}
  ' "$OUT" 2>/dev/null || true)"
  if [ -n "$notes" ]; then
    echo
    echo "  Good to know:"
    printf '%s\n' "$notes" | sed 's/^/  /'
  fi
}

main() {
  local version file top gnupg rc=0 arg callers_umask

  for arg in "$@"; do
    case "$arg" in
      -h | --help)
        usage
        exit 0
        ;;
    esac
  done

  # The key is for installer/install.sh alone: out of the environment before
  # curl, gpg, tar or anything else is started.
  LICKEY="${FREEPANEL_LICENSE_KEY:-}"
  unset FREEPANEL_LICENSE_KEY

  [ "$(uname -s)" = Linux ] || die "freePanel installs on Linux only"
  case "$(uname -m)" in
    x86_64 | amd64) ;;
    *) die "freePanel is built for x86_64 only; this machine is $(uname -m)" ;;
  esac
  if [ "$NEED_ROOT" = 1 ] && [ "$(id -u)" -ne 0 ]; then
    die "run this as root: curl -fsSL $BASE/install | sudo bash"
  fi
  command -v curl >/dev/null 2>&1 || die "curl is needed"
  command -v tar >/dev/null 2>&1 || die "tar is needed"
  # Before anything is fetched or installed: a copy with no pin refuses here.
  require_pin
  need_gpg
  plan "$@"

  banner
  printf '  Server:      %s\n  Installing:  %s\n  Log:         %s\n\n' "$HOST" "$WHAT" "$LOG_FILE"

  # Everything this script makes is for root alone; the installer gets the
  # umask it would have had if it had been run by hand.
  callers_umask="$(umask)"
  umask 077
  TMP="$(make_workdir)" || die "could not make a folder where programs may run, under ${WORK_BASES[*]}"
  case "$TMP" in
    "${WORK_BASES[0]}"/*) ;;
    *) say "${WORK_BASES[0]} does not allow running programs; working under ${TMP%/*}" ;;
  esac
  # gpg may have started an agent for the keyring: stop it, then remove the folder.
  trap 'gpgconf --homedir "$TMP/gnupg" --kill all >/dev/null 2>&1 || true; rm -rf -- "$TMP"' EXIT
  trap 'exit 130' INT TERM HUP
  OUT="$TMP/installer.out"

  gnupg="$TMP/gnupg"
  make_keyring "$gnupg"

  # The newest release, unless one was asked for with FREEPANEL_RELEASE.
  version="${FREEPANEL_RELEASE:-}"
  if [ -z "$version" ]; then
    fetch "$BASE/releases/latest" "$TMP/latest" 256
    version="$(head -n 1 "$TMP/latest" | tr -d '\r')"
  fi
  [[ $version =~ ^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$ ]] || die "the release name is not one this installer understands"
  top="freepanel-$version"
  file="$top-linux-amd64.tar.gz"
  say "Downloading freePanel $version"

  fetch "$BASE/releases/$file" "$TMP/$file" 800000000
  fetch "$BASE/releases/$file.asc" "$TMP/$file.asc" 16384
  verify_signature "$gnupg" "$TMP/$file.asc" "$TMP/$file" ||
    die "the signature of $file is not a good signature of the pinned key: nothing was unpacked or installed"
  say "The signature is good"

  tar -tzf "$TMP/$file" >"$TMP/list" 2>/dev/null || die "$file is not a readable tarball"
  check_names "$TMP/list" "$top" || die "$file holds entries outside $top/: nothing was unpacked"
  mkdir -m 700 -- "$TMP/src"
  tar -xzf "$TMP/$file" -C "$TMP/src" --no-same-owner || die "could not unpack $file"
  [ -f "$TMP/src/$top/installer/install.sh" ] || die "$file has no installer/install.sh"

  say "Installing. This takes a few minutes; the details go to the log"
  { : >>"$LOG_FILE" && chmod 600 "$LOG_FILE"; } 2>/dev/null || die "could not write the log $LOG_FILE"
  : >"$OUT"
  printf '\n== %s freePanel %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$version" 2>/dev/null >>"$LOG_FILE" || true
  umask "$callers_umask"
  # Not exec: the folder is removed afterwards.
  run_installer "$TMP/src/$top/installer/install.sh" "$TMP/rc" "${ARGV[@]}" || rc=$?
  if [ "$rc" != 0 ]; then
    {
      printf '\nfreePanel installer: the install stopped (exit %s) at: %s\n' "$rc" \
        "$(grep -a '==> ' "$OUT" | tail -n 1 | sed 's/^.*==> //; s/\x1b\[[0-9;]*m//g' || true)"
      echo "The last lines it printed:"
      tail -n 12 "$OUT" | sed 's/\x1b\[[0-9;]*m//g; s/^/    /'
      echo "Nothing is deleted. Fix what it says and run the same command again: the installer carries on from where it is."
      echo "Everything it printed is in $LOG_FILE"
    } >&2
    exit "$rc"
  fi
  summary
}

main "$@"
