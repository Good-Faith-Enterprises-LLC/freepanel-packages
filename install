#!/usr/bin/env bash
# freePanel's one-line installer. It is served at
# https://repo.atlantishosting.net/install and used like this:
#
#   curl -fsSL https://repo.atlantishosting.net/install | sudo bash
#
# That installs freePanel with the panel and its services, with the server's
# own name as its hostname, and prints the address where you create your
# admin login. The licence key is entered afterwards on the panel's Licence
# page. To give it up front, keep it off every command line (a command line
# is readable by every user of the server while it runs, and sudo's own
# command line is one: "sudo FREEPANEL_LICENSE_KEY=KEY bash" shows the key and
# sudo may log it). Put it in your shell's environment and have sudo pass the
# environment on:
#
#   export FREEPANEL_LICENSE_KEY=YOUR-KEY
#   curl -fsSL https://repo.atlantishosting.net/install | sudo -E bash
#
# (As root, without sudo: "FREEPANEL_LICENSE_KEY=YOUR-KEY bash" is enough.)
#
# For anyone who wants to choose, the flags of installer/install.sh go after
# "bash -s --", for example "| sudo bash -s -- --hostname panel.example.com".
# A flag that names a component (--web, --mail, ...) means you choose the
# components: the installer is then given your flags, and the server's name
# as --hostname if you gave none, and --protect unless --no-firewall is
# given. Other flags
# (--hostname, --no-firewall, --php, ...) change the defaults and keep them.
# "bash -s -- --help" lists them.
#
# This script takes the licence key out of its own environment at once, so
# that none of the programs it starts for the download sees it, and hands it
# to installer/install.sh alone, through that program's environment.
#
# This script does these things, in this order, and nothing else:
#
#   1. checks that it runs as root on Linux x86_64, and that gpg is there
#      (it installs gpg from the system's own repositories if it is not);
#   2. decides what to install. With no component flags that is the panel
#      and its services on AlmaLinux, Rocky Linux or RHEL 9 (websites,
#      databases with their admin tool, DNS, mail, webmail with calendars and
#      contacts, FTP, the firewall and login protection; the installer
#      turns firewalld on where it is off, on AlmaLinux, Rocky Linux and
#      RHEL, keeping SSH and the services' ports open). The
#      server's own name is the hostname, if it is a full name such as
#      server.example.com; if it is not, the script stops and says so;
#   3. asks $BASE/releases/latest which release is the newest. Only a
#      version name is taken from the answer, and only if it is plain
#      (FREEPANEL_RELEASE=1.2.3 asks for a release by name instead);
#   4. downloads that release's tarball and its detached signature;
#   5. checks the signature with the public key pinned below, in a keyring
#      that holds that key and no other. It must be a good signature made by
#      the pinned key or one of its subkeys, and anything else (a bad,
#      expired or revoked signature, another key, no signature) stops here,
#      before the tarball is opened. A checksum from the same place would
#      prove nothing, so there is none;
#   6. unpacks the tarball in a new private folder (under /var/tmp, or under
#      /root if /var/tmp does not allow running programs), after checking
#      that every entry lies under freepanel-VERSION/;
#   7. runs installer/install.sh from it, writes what it says to the log
#      (/var/log/freepanel-install.log) and shows one short line for each of
#      its steps, then prints the addresses to sign in at and the notes the
#      installer ends with, and removes the folder.
#
# Nothing is installed, and no file outside the private folder is written,
# before the signature has been checked (but for gpg itself, from the
# system's own repositories, if it is missing). It fails closed: on any doubt
# it prints why and stops with a non-zero status. A failed install can be run
# again: the installer keeps what it has made and carries on.
#
# The pin is below. While it is empty this script refuses to run, so a copy
# of this file from before the signing key existed can do nothing. The whole
# script is one function that is called on its last line, so a download that
# was cut short does nothing either. Its standard input is not given to the
# installer, which would otherwise read the rest of a piped script.
#
# What this does not protect against: this script itself comes over HTTPS
# from the address above, so whoever controls that address (or its
# certificate) can give out a script with a different pin. The signature
# protects the tarball against the place it is stored and the way it is
# fetched, and lets anyone check this script before running it: install.asc
# is its detached signature with the same key. See packaging/bootstrap/README.md.
#
# The seven lines marked "test hook" are rewritten by the tests in a copy of
# this file; they are the only things a test changes.
set -euo pipefail

BASE="https://repo.atlantishosting.net"        # test hook
CURL_PROTO="=https"                            # test hook
NEED_ROOT=1                                    # test hook
PINNED_FPR="F01D2B342B05DEC594EA35C9603BE9FF5860560D"  # test hook; full fingerprint of the primary key, no spaces
LOG_FILE="/var/log/freepanel-install.log"      # test hook
OS_RELEASE="/etc/os-release"                   # test hook
WORK_BASES=(/var/tmp /root)                    # test hook; where the private folder may go, in order

# The services a plain run installs on AlmaLinux, Rocky Linux and RHEL 9.
# --dbadmin is in: the browser is sent straight to its port (7445), so the
# installer opens that port with the panels' under --open-firewall (41-2),
# which a plain run gives. That is the owner's choice (Oct 29, 21:50Z): the
# database admin tool is in a plain install and its port is open.
FULL_FLAGS=(--web --mysql --postgres --dns --mail --spam --dbadmin --webmail --dav --ftp)

# gpg never fetches or imports a key by itself: the keyring is the pinned key.
GPG=(gpg --batch --no-tty --no-auto-key-import --no-auto-key-retrieve)

